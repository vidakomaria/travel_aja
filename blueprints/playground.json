{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "6.8.2"
  },
  "siteOptions": {
    "blogname": "Travel Aja Demo",
    "show_on_front": "page"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/vidakomaria/travel_aja",
        "ref": "main",
        "refType": "branch",
        "path": "wp-content/plugins/travel-aja-content"
      },
      "options": {
        "activate": true,
        "targetFolderName": "travel-aja-content"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/vidakomaria/travel_aja",
        "ref": "main",
        "refType": "branch",
        "path": "wp-content/themes/custom-theme"
      },
      "options": {
        "activate": false,
        "targetFolderName": "custom-theme"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/vidakomaria/travel_aja",
        "ref": "main",
        "refType": "branch",
        "path": "wp-content/themes/custom-theme-v2"
      },
      "options": {
        "activate": true,
        "targetFolderName": "custom-theme-v2"
      }
    },
    {
      "step": "importWxr",
      "file": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/vidakomaria/travel_aja/main/demo-content/travel-aja-demo.xml"
      },
      "defaultAuthorUsername": "admin",
      "fetchAttachments": false,
      "importUsers": false,
      "rewriteUrls": true
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire_once '/wordpress/wp-load.php';\n$home = get_page_by_path( 'beranda', OBJECT, 'page' );\n$guides = get_page_by_path( 'panduan-wisata', OBJECT, 'page' );\nif ( $home ) { update_option( 'show_on_front', 'page' ); update_option( 'page_on_front', $home->ID ); }\nif ( $guides ) { update_option( 'page_for_posts', $guides->ID ); }\n"
    }
  ]
}
