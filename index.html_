    <script type="application/ld+json">
    {
      "@context" : "http://schema.org",
      "@type" : "Organization",

      
      "name" : "Travel Aja",
      

      
      "url" : "http:\/\/transijen.com",
      

      

      
      "contactPoint" : [{
        "@type" : "ContactPoint",
        "telephone" : "+6281 1250 242",
        "contactType" : "customer service"
      }]
      
    }
</script>

