<body>

    
    <div class="brand">Travel Aja</div>
    

    
    <div class="address-bar"> Jalan Ikan Cakalang No: 18 Banyuwangi | +6281 1250 242</div>
    

    <div class="container">

        <div class="row">
            <div class="box">
                <div class="col-lg-12 text-center">
                    <img class="img-responsive img-full" src="img/office.jpg" alt="">
                    
                    <h2 class="brand-before">
                        <small>Welcome to</small>
                    </h2>
                    <h1 class="brand-name">Travel Aja</h1>
                    
                    
                    <hr class="tagline-divider">
                    <h2>
                        <small>
                            <strong>Explore With Us</strong>
                        </small>
                    </h2>
                    
                </div>
            </div>
        </div>

        
        <div class="row">
            <div class="box">
                <div class="col-lg-12">
                    
                    
                    <p>This Website Is Under Construction</p>
                    
                </div>
            </div>
        </div>
        

        
        <div class="row">
            <div class="box">
                <div class="col-lg-12">
                    
                    <hr>
                    <h2 class="intro-text text-center">Contact
                        <strong>Travel Aja</strong>
                    </h2>
                    <hr>
                    
                </div>
                
                
                <div class="col-lg-12">
                    
                    <p>
                        Address: <strong>Jalan Ikan Cakalang No: 18 Banyuwangi</strong>
                    </p>
                    

                    
                    <p>
                        
                            Phone: <strong>+6281 1250 242</strong> <br/>
                        

                        

                        
                            Email: <strong><a href="mailto:transijen%40gmail.com">transijen@gmail.com</a></strong> <br/>
                        

                        

                        
                    </p>
                    
                </div>
                
                <div class="clearfix"></div>
            </div>
